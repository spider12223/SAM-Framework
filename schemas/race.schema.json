{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spider12223.github.io/SAM-Framework/schemas/race.schema.json",
  "title": "S.A.M Custom Playable Race",
  "description": "A mod-defined playable race that rides an existing monster body. Registered into a reserved race id (200-255); appears in the character-select race picker, renders as its host body in both third- and first-person, and applies flat attribute/HP/MP bonuses at character creation. A vanilla or mod-less client that loads such a character plays it as Human (graceful degrade).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "host_body"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+:[a-z0-9_]+$",
      "description": "Unique id in \"namespace:race\" form, e.g. \"mymod:frostborn\"."
    },
    "name": {
      "type": "string",
      "description": "Display name shown in the character-select race picker, e.g. \"Frostborn\"."
    },
    "host_body": {
      "type": "string",
      "enum": [
        "human",
        "skeleton",
        "vampire",
        "succubus",
        "incubus",
        "goblin",
        "automaton",
        "insectoid",
        "goatman",
        "gnome",
        "gremlin",
        "dryad",
        "myconid",
        "salamander",
        "troll",
        "spider",
        "imp",
        "rat"
      ],
      "description": "The existing monster body this race renders as. Only these 18 bodies have a proper first-person arm, so both views are correct."
    },
    "description": {
      "type": "string",
      "description": "Short flavour text for the race (shown in the picker's info panel)."
    },
    "stat_modifiers": {
      "type": "object",
      "additionalProperties": false,
      "description": "Flat attribute / HP / MP bonuses added at character creation (may be negative). Vanilla races give no attribute bonuses, so these are the race's whole stat identity.",
      "properties": {
        "STR": {
          "type": "integer"
        },
        "DEX": {
          "type": "integer"
        },
        "CON": {
          "type": "integer"
        },
        "INT": {
          "type": "integer"
        },
        "PER": {
          "type": "integer"
        },
        "CHR": {
          "type": "integer"
        },
        "HP": {
          "type": "integer"
        },
        "MP": {
          "type": "integer"
        }
      }
    },
    "blood_diet": {
      "type": "boolean",
      "default": false,
      "description": "If true, this race sustains on blood instead of food (like a vampire)."
    },
    "starting_spells": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Innate spells this race knows from creation. Vanilla \"SPELL_X\" names or your own \"namespace:spell\"."
    },
    "allies": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "human",
          "rat",
          "goblin",
          "slime",
          "troll",
          "bat",
          "spider",
          "ghoul",
          "skeleton",
          "scorpion",
          "imp",
          "crab",
          "gnome",
          "demon",
          "succubus",
          "mimic",
          "lich",
          "minotaur",
          "devil",
          "shopkeeper",
          "kobold",
          "scarab",
          "crystalgolem",
          "incubus",
          "vampire",
          "shadow",
          "cockatrice",
          "insectoid",
          "goatman",
          "automaton",
          "lichice",
          "lichfire",
          "sentrybot",
          "spellbot",
          "gyrobot",
          "dummybot",
          "bugbear",
          "dryad",
          "myconid",
          "salamander",
          "gremlin",
          "revenant_skull",
          "minimimic",
          "monster_adorcised_weapon",
          "flame_elemental",
          "hologram",
          "moth",
          "earth_elemental",
          "duck_small"
        ]
      },
      "uniqueItems": true,
      "description": "Monster types that will not attack this race, and that this race will not attack, on top of whatever the host body already gets along with. A goatman-bodied race is already left alone by goatmen; this is for relations the host body does NOT have, e.g. [\"gnome\", \"troll\"]. Leave it out to inherit the host body's relations unchanged."
    },
    "enemies": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "human",
          "rat",
          "goblin",
          "slime",
          "troll",
          "bat",
          "spider",
          "ghoul",
          "skeleton",
          "scorpion",
          "imp",
          "crab",
          "gnome",
          "demon",
          "succubus",
          "mimic",
          "lich",
          "minotaur",
          "devil",
          "shopkeeper",
          "kobold",
          "scarab",
          "crystalgolem",
          "incubus",
          "vampire",
          "shadow",
          "cockatrice",
          "insectoid",
          "goatman",
          "automaton",
          "lichice",
          "lichfire",
          "sentrybot",
          "spellbot",
          "gyrobot",
          "dummybot",
          "bugbear",
          "dryad",
          "myconid",
          "salamander",
          "gremlin",
          "revenant_skull",
          "minimimic",
          "monster_adorcised_weapon",
          "flame_elemental",
          "hologram",
          "moth",
          "earth_elemental",
          "duck_small"
        ]
      },
      "uniqueItems": true,
      "description": "Monster types that are always hostile to this race, even ones the host body gets along with. Listing a type in both allies and enemies makes it an enemy, and the game log says so."
    }
  }
}
